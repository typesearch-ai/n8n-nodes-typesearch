{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"declaration": false,
		"sourceMap": false
	},
	"include": ["credentials/**/*", "nodes/**/*", "test/**/*", "vitest.config.mts"]
}
